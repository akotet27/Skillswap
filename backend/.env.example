# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

ENVIRONMENT=development
# development | production  -- /docs and /redoc are only disabled when this is "production"

# --- Database ---
DATABASE_URL=postgresql+psycopg://skillswap:skillswap@localhost:5432/skillswap

# --- Redis (cache, rate-limit store, Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Email (any SMTP-compatible provider, e.g. Resend's SMTP relay) ---
# "console" (default) never sends real mail -- it logs the email instead.
# Change to "smtp" only when you actually want messages delivered.
EMAIL_BACKEND=console
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@skillswap.local
MAIL_FROM_NAME=SkillSwap
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# --- TURN (ExpressTURN free tier, or Open Relay / Metered as fallback) ---
# Sign up at https://www.expressturn.com/ (no card required on the free tier
# at time of writing -- re-check before relying on it). These are relayed
# to the frontend via GET /api/video/ice-servers so the secret never lives
# in frontend source.
TURN_URL=turn:relay1.expressturn.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Password hashing / OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10

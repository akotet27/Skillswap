# Copy this file to `.env` and fill in real values. `.env` is git-ignored.

ENVIRONMENT=development
# development | production  -- /docs and /redoc are only disabled when this is "production"

# --- Database ---
DATABASE_URL=postgresql+psycopg://skillswap:skillswap@localhost:5432/skillswap

# --- Redis (cache, rate-limit store, Celery broker/backend) ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (https://console.cloud.google.com/apis/credentials) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- CORS ---
FRONTEND_ORIGIN=http://localhost:5173

# --- Email ---
# "console" (default) never sends real mail -- it logs the email instead.
# "smtp" sends via any SMTP-compatible provider using MAIL_* below -- works
# locally, but many free hosts block outbound SMTP ports (confirmed on
# Render's free web service: connections to smtp.resend.com:587 time out).
# "resend" sends via Resend's HTTPS API instead (needs RESEND_API_KEY, not
# the MAIL_* settings) -- use this one on a host that blocks raw SMTP.
EMAIL_BACKEND=console
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@skillswap.local
MAIL_FROM_NAME=SkillSwap
MAIL_SERVER=smtp.resend.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
RESEND_API_KEY=

# --- TURN (ExpressTURN free tier, or Open Relay / Metered as fallback) ---
# Sign up at https://www.expressturn.com/ (no card required on the free tier
# at time of writing -- re-check before relying on it). These are relayed
# to the frontend via GET /api/video/ice-servers so the secret never lives
# in frontend source.
TURN_URL=turn:relay1.expressturn.com:3478
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Password hashing / OTP ---
OTP_LENGTH=6
OTP_EXPIRE_MINUTES=5
# Dev convenience: uncomment to let this exact code always pass signup-OTP
# and 2FA verification too, alongside the real code -- so testing those
# flows doesn't require reading a log/inbox every time. Never has any
# effect when ENVIRONMENT=production, even if left set by accident (see
# app/core/security.py's is_test_bypass_code) -- still, leave this unset
# anywhere real users might sign up.
# OTP_TEST_BYPASS_CODE=000000

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
